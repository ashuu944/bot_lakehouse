# MinIO AIStor (S3-compatible object storage, licensed distribution)
MINIO_ROOT_USER=lakehouse_admin
MINIO_ROOT_PASSWORD=change_me_please
# Container-internal address -- every service (Spark, Airflow, Trino,
# minio-init) reaches MinIO through this over the docker network, which
# NEVER goes through the host-mapped port below. Leave this as :9000 even
# if you change MINIO_API_HOST_PORT -- they are unrelated numbers.
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=lakehouse
# Host-side ports only -- change these (not MINIO_ENDPOINT, not anything in
# docker-compose.yml) if 9000/9001 are already taken by something else on
# this host. Safe to leave unset; they default to 9000/9001.
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# Not read by docker-compose directly -- documented here only; the actual
# license file AIStor loads at startup is minio/minio.license (gitignored).
# Get one from the MinIO pricing page ("Get Started" -> free tier) or your
# existing SUBNET account, save it to minio/minio.license.
MINIO_LICENSE=

# GitHub personal access token with read access to ashuu944/bsis_extractor
# (used only as a Docker build secret — never baked into an image layer)
GIT_HUB_TOKEN=

# BSIS Oracle connection, consumed by bsis_extractor (pydantic-settings reads
# these directly from the environment — no .env file needed inside the container)
DB_USER=
DB_PASSWORD=
DB_DSN=host:port/service_name
BSIS_ENV=dev

# Reference/master data CSVs, merged with BSIS data during Silver transforms.
# Lives inside this repo, nested under DFSS/BSIS since it's master data OF
# BSIS (not a separate source) -- see spark/master_data/DFSS/BSIS/.
MASTER_DATA_PATH=./spark/master_data/DFSS/BSIS

# Airflow webserver login (http://localhost:8895)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_please

# Linux only -- the host's docker group GID, so the Airflow containers can
# use the Docker-outside-of-Docker socket (DockerOperator tasks fail with a
# PermissionError without this). Find it with:
#   stat -c '%g' /var/run/docker.sock
# Leave unset on Docker Desktop (Windows/Mac) -- not needed there.
DOCKER_GID=

# Absolute path to this project ON THE HOST (not inside any container), used
# only by DockerOperator -- see the comment on HOST_PROJECT_DIR in
# docker-compose.yml for why. Must match wherever THIS .env lives on THIS
# machine -- when deploying to a new server, set this to that server's path,
# don't copy the value from another machine's .env.
HOST_PROJECT_DIR=/absolute/path/to/bot_lakehouse

# Airflow's own metadata database -- separate from the lakehouse data itself.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change_me_please
AIRFLOW_POSTGRES_DB=airflow

# Generate your own, don't reuse this one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# OpenMetadata's own catalog store -- separate Postgres instance from
# AIRFLOW_POSTGRES_* above (different system, different lifecycle).
OM_POSTGRES_SUPERUSER_PASSWORD=change_me_please
OM_DB_USER=openmetadata_user
OM_DB_USER_PASSWORD=change_me_please
OM_DATABASE=openmetadata_db

# Fetched once from the OpenMetadata UI after first login: Settings -> Bots
# -> ingestion-bot -> token. Can't be generated ahead of time.
OM_INGESTION_BOT_TOKEN=
OM_SERVER_HOST_PORT=http://om-server:8585/api
TRINO_USERNAME=lakehouse_ingestion
